<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Structa.UI.App"
             xmlns:local="using:Structa.UI"
             RequestedThemeVariant="Default">
             <!-- O tema efetivo (Light/Dark) é aplicado em runtime pelo IThemeService, a partir da preferência salva. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="avares://Structa.UI/Themes/LightTheme.axaml" />
                <ResourceInclude x:Key="Dark" Source="avares://Structa.UI/Themes/DarkTheme.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
