<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Structa.UI.ViewModels"
             xmlns:selection="using:Structa.Core.Selection"
             xmlns:editor="using:Structa.Core.Editor"
             x:Class="Structa.UI.Views.SideBarView"
             x:DataType="vm:SideBarViewModel">

  <Border Background="{DynamicResource StructaSideBarBackgroundBrush}"
          BorderBrush="{DynamicResource StructaBorderBrush}"
          BorderThickness="0,0,1,0">
    <TabControl>
      <TabItem Header="Entidades">
        <StackPanel Margin="12" Spacing="10">
          <TextBlock Text="Modo de seleção" FontWeight="SemiBold"
                     Foreground="{DynamicResource StructaTextPrimaryBrush}" />

          <UniformGrid Columns="2">
            <Button Content="Vértice" Margin="0,0,4,4" HorizontalContentAlignment="Center"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static selection:SelectionMode.Vertex}" />
            <Button Content="Aresta" Margin="4,0,0,4" HorizontalContentAlignment="Center"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static selection:SelectionMode.Edge}" />
            <Button Content="Face" Margin="0,0,4,0" HorizontalContentAlignment="Center"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static selection:SelectionMode.Face}" />
            <Button Content="Objeto" Margin="4,0,0,0" HorizontalContentAlignment="Center"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static selection:SelectionMode.Object}" />
          </UniformGrid>

          <TextBlock Text="{Binding ModeLabel}" Foreground="{DynamicResource StructaTextSecondaryBrush}" />

          <Separator />

          <TextBlock Text="{Binding SelectionSummary}"
                     Foreground="{DynamicResource StructaTextSecondaryBrush}"
                     TextWrapping="Wrap" />

          <TextBlock Text="Clique com o botão esquerdo para selecionar. Shift+clique soma à seleção. Esc limpa."
                     Foreground="{DynamicResource StructaTextSecondaryBrush}"
                     FontSize="11" TextWrapping="Wrap" Opacity="0.8" />

          <Separator />

          <TextBlock Text="Espelhar seleção" FontWeight="SemiBold"
                     Foreground="{DynamicResource StructaTextPrimaryBrush}" />

          <UniformGrid Columns="3">
            <Button Content="Eixo X" Margin="0,0,4,0" HorizontalContentAlignment="Center"
                    Command="{Binding MirrorCommand}" CommandParameter="{x:Static editor:MirrorAxis.X}" />
            <Button Content="Eixo Y" Margin="4,0,4,0" HorizontalContentAlignment="Center"
                    Command="{Binding MirrorCommand}" CommandParameter="{x:Static editor:MirrorAxis.Y}" />
            <Button Content="Eixo Z" Margin="4,0,0,0" HorizontalContentAlignment="Center"
                    Command="{Binding MirrorCommand}" CommandParameter="{x:Static editor:MirrorAxis.Z}" />
          </UniformGrid>

          <TextBlock Text="Só funciona com o objeto inteiro selecionado (modo Objeto) — reflete pelo plano perpendicular ao eixo escolhido, passando pelo centro da seleção."
                     Foreground="{DynamicResource StructaTextSecondaryBrush}"
                     FontSize="11" TextWrapping="Wrap" Opacity="0.8" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Materiais">
        <TextBlock Text="Biblioteca de materiais — disponível na Etapa 10."
                   Foreground="{DynamicResource StructaTextSecondaryBrush}"
                   Margin="12" TextWrapping="Wrap" />
      </TabItem>
      <TabItem Header="Tags">
        <TextBlock Text="Layers / Tags — disponível em etapa futura."
                   Foreground="{DynamicResource StructaTextSecondaryBrush}"
                   Margin="12" TextWrapping="Wrap" />
      </TabItem>
      <TabItem Header="Cenas">
        <TextBlock Text="Cenas / Cortes — disponível em etapa futura."
                   Foreground="{DynamicResource StructaTextSecondaryBrush}"
                   Margin="12" TextWrapping="Wrap" />
      </TabItem>
    </TabControl>
  </Border>

</UserControl>
