<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Structa.UI.ViewModels"
             xmlns:views="using:Structa.UI.Views"
             x:Class="Structa.UI.Views.ViewportView"
             x:DataType="vm:ViewportViewModel">

  <Panel Background="{DynamicResource StructaViewportBackgroundBrush}">
    <views:RenderViewport x:Name="RenderSurface" FramesPerSecond="{Binding Fps, Mode=OneWayToSource}" />

    <!--
      O RenderViewport compõe seu conteúdo via textura de GPU compartilhada e não participa do
      hit-testing normal do Avalonia. Este overlay transparente (precisa de Background para ser
      hit-testável) captura mouse/teclado e repassa para a navegação da câmera.
    -->
    <Border x:Name="InputSurface"
            Background="Transparent"
            Focusable="True" />

    <Border Background="#66000000"
            CornerRadius="4"
            Padding="8,4"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding Fps, StringFormat='{}{0:0} FPS'}"
                 Foreground="White"
                 FontFamily="Consolas,monospace"
                 FontSize="12" />
    </Border>
  </Panel>

</UserControl>
