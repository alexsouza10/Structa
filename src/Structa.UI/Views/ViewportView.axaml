<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Structa.UI.ViewModels"
             xmlns:views="using:Structa.UI.Views"
             x:Class="Structa.UI.Views.ViewportView"
             x:DataType="vm:ViewportViewModel">

  <Panel Background="{DynamicResource StructaViewportBackgroundBrush}">
    <views:RenderViewport x:Name="RenderSurface"
                           FramesPerSecond="{Binding Fps, Mode=OneWayToSource}"
                           ToolStatusText="{Binding ToolStatusText, Mode=OneWayToSource}" />

    <!--
      O RenderViewport compõe seu conteúdo via textura de GPU compartilhada e não participa do
      hit-testing normal do Avalonia. Este overlay transparente (precisa de Background para ser
      hit-testável) captura mouse/teclado e repassa para a navegação da câmera.
    -->
    <Border x:Name="InputSurface"
            Background="Transparent"
            Focusable="True" />

    <Border Background="#66000000"
            CornerRadius="4"
            Padding="8,4"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding Fps, StringFormat='{}{0:0} FPS'}"
                 Foreground="White"
                 FontFamily="Consolas,monospace"
                 FontSize="12" />
    </Border>

    <Border Background="#66000000"
            CornerRadius="4"
            Padding="8,4"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False">
      <TextBlock Text="Linha (L): clique, clique, fecha a aresta e encadeia. Empurrar/Puxar (P): clique numa face e arraste. Mover (M): arrasta a seleção (Ctrl duplica). Rotacionar (R) e Escalar (S): arrastam ao redor do centro da seleção. Dígitos definem um valor exato, Enter confirma, Esc cancela."
                 Foreground="White"
                 FontSize="11"
                 MaxWidth="420"
                 TextWrapping="Wrap" />
    </Border>

    <Border Background="#CC000000"
            CornerRadius="4"
            Padding="10,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            IsHitTestVisible="False"
            IsVisible="{Binding ToolStatusText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ToolStatusText}"
                 Foreground="White"
                 FontFamily="Consolas,monospace"
                 FontSize="14"
                 FontWeight="Bold" />
    </Border>
  </Panel>

</UserControl>
