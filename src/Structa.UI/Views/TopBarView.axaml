<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Structa.UI.ViewModels"
             xmlns:editor="using:Structa.Core.Editor"
             x:Class="Structa.UI.Views.TopBarView"
             x:DataType="vm:TopBarViewModel">

  <Border Background="{DynamicResource StructaTopBarBackgroundBrush}"
          BorderBrush="{DynamicResource StructaBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="8,4">
    <DockPanel LastChildFill="True">

      <TextBlock Text="Structa" FontWeight="Bold" FontSize="16"
                 Foreground="{DynamicResource StructaTextPrimaryBrush}"
                 VerticalAlignment="Center" Margin="4,0,20,0"
                 DockPanel.Dock="Left" />

      <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Left" Margin="0,0,20,0" VerticalAlignment="Center">
        <ToggleButton Content="Selecionar"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.Select}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Select}" />
        <ToggleButton Content="Linha (L)"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.Line}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Line}" />
        <ToggleButton Content="Empurrar/Puxar (P)"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.PushPull}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.PushPull}" />
        <ToggleButton Content="Mover (M)"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.Move}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Move}" />
        <ToggleButton Content="Rotacionar (R)"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.Rotate}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Rotate}" />
        <ToggleButton Content="Escalar (S)"
                      IsChecked="{Binding ActiveTool, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static editor:EditorTool.Scale}}"
                      Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Scale}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="Tema escuro" VerticalAlignment="Center"
                   Foreground="{DynamicResource StructaTextSecondaryBrush}" />
        <ToggleSwitch IsChecked="{Binding IsDarkTheme}" OnContent="{x:Null}" OffContent="{x:Null}" />
      </StackPanel>

      <Menu VerticalAlignment="Center">
        <MenuItem Header="_Arquivo">
          <MenuItem Header="_Novo" IsEnabled="False" />
          <MenuItem Header="_Abrir..." IsEnabled="False" />
          <MenuItem Header="_Salvar" IsEnabled="False" />
          <Separator />
          <MenuItem Header="Sai_r" Command="{Binding ExitCommand}" />
        </MenuItem>
        <MenuItem Header="_Editar">
          <MenuItem Header="_Desfazer" IsEnabled="False" />
          <MenuItem Header="_Refazer" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="Câ_mera">
          <MenuItem Header="Ó_rbita" IsEnabled="False" />
          <MenuItem Header="_Pan" IsEnabled="False" />
          <MenuItem Header="_Zoom" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Desenhar">
          <MenuItem Header="_Linha" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Line}" />
          <MenuItem Header="A_rco" IsEnabled="False" />
          <MenuItem Header="_Retângulo" IsEnabled="False" />
          <MenuItem Header="_Círculo" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="_Ferramentas">
          <MenuItem Header="_Empurrar/Puxar" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.PushPull}" />
          <MenuItem Header="_Mover" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Move}" />
          <MenuItem Header="_Rotacionar" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Rotate}" />
          <MenuItem Header="Es_calar" Command="{Binding SetToolCommand}" CommandParameter="{x:Static editor:EditorTool.Scale}" />
        </MenuItem>
        <MenuItem Header="_Janela">
          <MenuItem Header="_Cenas" IsEnabled="False" />
          <MenuItem Header="_Materiais" IsEnabled="False" />
        </MenuItem>
        <MenuItem Header="Aj_uda">
          <MenuItem Header="_Sobre o Structa" IsEnabled="False" />
        </MenuItem>
      </Menu>
    </DockPanel>
  </Border>

</UserControl>
